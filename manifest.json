{
  "manifest_version": 3,
  "name": "MeetMind AI — Preview",
  "version": "0.1.0",
  "description": "Preview UI for a real-time AI meeting copilot.",
  "permissions": ["sidePanel", "storage", "activeTab"],
  "action": {
    "default_title": "MeetMind AI",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}